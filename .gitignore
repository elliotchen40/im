# ============================================================
# im —— 仓库级忽略规则
# ============================================================
# 子目录还有各自的 .gitignore（`server/.gitignore`、`app/.gitignore`），
# 这里放根级与跨目录的通用规则。
# ============================================================

# ---- Reasonix 工具运行时状态（任务快照 + 事件日志，本地生成，不入库）----
.reasonix/

# ---- 依赖与构建产物（子目录 .gitignore 也覆盖，这里兜底）----
node_modules/
dist/
build/
*.tsbuildinfo

# ---- 密钥与本地配置（.env.example 不受影响）----
.env
.env.local
.env.*.local

# ---- 运行时数据（SQLite / 渠道队列 / SOUL 数据）----
data/

# ---- 编辑器与系统 ----
.DS_Store
.idea/
.vscode/
*.swp
*.iml

# ---- 日志与临时文件 ----
*.log
*.tmp
