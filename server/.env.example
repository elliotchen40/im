# ============================================================
# im 服务端 —— 环境变量模板
# ============================================================
# 复制为 .env 后填写：cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# 渠道（自研 IM 协议，取代微信 iLink）
# ------------------------------------------------------------
# 必填。app 与服务端之间的共享密钥。为空时服务端拒绝启动（拒绝裸奔）。
# 生成：openssl rand -hex 32
#
# 有了扫码配对后，这个值**不需要手动填进 app**：
# 服务器上跑 `npm run pair` 出二维码，app 扫码即自动取回地址与 token。
IM_APP_TOKEN=

# 扫码配对时写进二维码的公网地址 —— 走 Cloudflare 隧道就填你的域名。
# 不填则回落到自动探测的局域网 IP（手机需与服务器同网）。
# IM_PUBLIC_URL=https://im.example.com

# HTTP 长轮询监听
IM_HTTP_PORT=8081
IM_BIND_HOST=0.0.0.0
IM_LONG_POLL_TIMEOUT_MS=35000

# 单用户模式下的渠道用户 ID（P2 做多用户/多设备时改为 deviceId → userId 映射）
IM_OWNER_USER_ID=owner

# 渠道数据目录（inbox.jsonl / outbox.jsonl / inbox.ack / pairing.json）
# 默认：<IM_BOT_DB_PATH 所在目录>/im
# IM_DATA_DIR=./data/im

# ------------------------------------------------------------
# 模型（多模型模式：MODEL_<NAME>_*，用 /model <name> 切换）
# ------------------------------------------------------------
# 单模型模式（向后兼容，会作为别名 "default" 出现）
#OPENAI_API_KEY=sk-xxx
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o
#OPENAI_CONTEXT_LIMIT=16384

# 多模型示例
MODEL_DSF_API_KEY=sk-xxx
MODEL_DSF_BASE_URL=https://api.deepseek.com
MODEL_DSF_MODEL=deepseek-chat

#MODEL_M3_API_KEY=sk-xxx
#MODEL_M3_BASE_URL=https://api.minimaxi.com/v1
#MODEL_M3_MODEL=minimax-m3

# ------------------------------------------------------------
# 人格（SOUL）
# ------------------------------------------------------------
# 必须匹配 soul/SOUL_<NAME>.md 命名；/soul 命令可运行时切换
SYSTEM_PROMPT_FILE=soul/SOUL_ASHLEY.md
# 或直接内联（被 SYSTEM_PROMPT_FILE 覆盖）
#SYSTEM_PROMPT=你是一个友好的AI助手。

SOUL_DIR=./soul
SOUL_SELECT_TIMEOUT_MS=10000

# ------------------------------------------------------------
# 记忆系统（embedding + 向量检索）
# ------------------------------------------------------------
# 必填。占位符 __FILL_IN_BY_LEADER_AFTER_P7__ 会被 embed.ts 硬抛
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_EMBEDDING_DIM=1024

# 检索策略
RAW_DIALOGUE_RETRIEVAL=fallback   # off / fallback / always
SHORT_TERM_WINDOW_SIZE=20
TOP_K=5
SIMILARITY_THRESHOLD=0.60         # 余弦阈值（上游 v3.0 收紧后的值；旧模板里的 0.35 已过松）
DEDUP_THRESHOLD=0.85

# summarizer
SUMMARY_HARD_TRIGGER_THRESHOLD=20
SUMMARY_IDLE_TIMEOUT_MS=300000
FACT_CONFIDENCE_GATE=0.6

# ------------------------------------------------------------
# 存储路径
# ------------------------------------------------------------
# 首选 IM_BOT_DB_PATH；回落 WX_BOT_DB_PATH（便于直接接管 wx-robot 既有 DB）
IM_BOT_DB_PATH=./data/im_bot.db

# ------------------------------------------------------------
# 主动关怀
# ------------------------------------------------------------
CARE_TICK_INTERVAL_MS=14400000    # 4h
